<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#F0F2F5"
    android:fillViewport="true"
    android:clipToPadding="false"
    android:paddingLeft="20dp"
    android:paddingTop="20dp"
    android:paddingRight="20dp"
    android:paddingBottom="80dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <!-- CABECERA -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:text="🛠️ PANEL DE CONTROL IT"
            android:textColor="#C8102E"
            android:textSize="22sp"
            android:textStyle="bold"
            android:layout_marginBottom="4dp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:text="Configuración y Diagnóstico de Flota - Grupo TGT"
            android:textColor="#5F6368"
            android:textSize="13sp"
            android:layout_marginBottom="24dp" />

        <!-- TARJETA 1: CONFIGURACIÓN DE UBICACIÓN (GRUPOS DEL EXCEL) -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="#FFFFFF"
            android:orientation="vertical"
            android:padding="16dp"
            android:layout_marginBottom="16dp"
            android:elevation="2dp">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="📍 Ubicación (Grupo del Excel)"
                android:textColor="#202124"
                android:textSize="15sp"
                android:textStyle="bold"
                android:layout_marginBottom="8dp" />

            <Spinner
                android:id="@+id/spinnerUbicaciones"
                android:layout_width="match_parent"
                android:layout_height="50dp"
                android:layout_marginBottom="12dp" />

            <Button
                android:id="@+id/btnGuardarUbicacion"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:backgroundTint="#C8102E"
                android:text="Guardar y Aplicar Ubicación"
                android:textColor="#FFFFFF"
                android:textStyle="bold" />
        </LinearLayout>

        <!-- TARJETA 2: CONFIGURACIÓN SMS Y SEGURIDAD (PIN) -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="#FFFFFF"
            android:orientation="vertical"
            android:padding="16dp"
            android:layout_marginBottom="16dp"
            android:elevation="2dp">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="🔒 Configuración de Alertas y Acceso"
                android:textColor="#202124"
                android:textSize="15sp"
                android:textStyle="bold"
                android:layout_marginBottom="12dp" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Teléfono IT para Alertas (SMS):"
                android:textColor="#5F6368"
                android:textSize="13sp"
                android:layout_marginBottom="4dp" />

            <EditText
                android:id="@+id/etTelefonoIT"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:inputType="phone"
                android:hint="Ej: 600000000"
                android:paddingHorizontal="12dp"
                android:layout_marginBottom="12dp" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Nuevo PIN de Acceso IT:"
                android:textColor="#5F6368"
                android:textSize="13sp"
                android:layout_marginBottom="4dp" />

            <EditText
                android:id="@+id/etNuevoPin"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:inputType="textPassword"
                android:hint="Ej: 1234"
                android:paddingHorizontal="12dp"
                android:layout_marginBottom="12dp" />

            <Button
                android:id="@+id/btnGuardarCredenciales"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:backgroundTint="#0288D1"
                android:text="Guardar Teléfono y PIN"
                android:textColor="#FFFFFF"
                android:textStyle="bold" />
        </LinearLayout>

        <!-- TARJETA 3: HERRAMIENTAS CLOUD Y RED -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="#FFFFFF"
            android:orientation="vertical"
            paddin="16dp"
            android:padding="16dp"
            android:layout_marginBottom="16dp"
            android:elevation="2dp">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="☁️ Herramientas Cloud y Red"
                android:textColor="#202124"
                android:textSize="15sp"
                android:textStyle="bold"
                android:layout_marginBottom="12dp" />

            <Button
                android:id="@+id/btnTestSincro"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:backgroundTint="#0288D1"
                android:text="Forzar Sincronización de Agenda (Excel)"
                android:textColor="#FFFFFF"
                android:textStyle="bold"
                android:layout_marginBottom="8dp" />

            <Button
                android:id="@+id/btnForzarOTA"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:backgroundTint="#E65100"
                android:text="Comprobar Actualización OTA (GitHub)"
                android:textColor="#FFFFFF"
                android:textStyle="bold" />
        </LinearLayout>

        <!-- TARJETA 4: ESTADO DEL SISTEMA E INFORMACIÓN TÉCNICA -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="#FFFFFF"
            android:orientation="vertical"
            android:padding="16dp"
            android:layout_marginBottom="24dp"
            android:elevation="2dp">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="🛡️ Estado de Seguridad y Versión"
                android:textColor="#202124"
                android:textSize="15sp"
                android:textStyle="bold"
                android:layout_marginBottom="8dp" />

            <TextView
                android:id="@+id/tvEstadoKiosco"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Comprobando sistema..."
                android:textColor="#5F6368"
                android:textSize="13sp"
                android:layout_marginBottom="12dp" />

            <Button
                android:id="@+id/btnAbrirAjustesAndroid"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:backgroundTint="#424242"
                android:text="Abrir Ajustes Generales de Android"
                android:textColor="#FFFFFF"
                android:textStyle="bold" />
        </LinearLayout>

        <!-- BOTÓN SALIR (Con margen extra para evitar la barra inferior de Android) -->
        <Button
            android:id="@+id/btnCerrarPanelIT"
            android:layout_width="match_parent"
            android:layout_height="60dp"
            android:backgroundTint="#202124"
            android:text="Cerrar Panel y Volver al Launcher"
            android:textColor="#FFFFFF"
            android:textStyle="bold"
            android:layout_marginBottom="20dp" />

    </LinearLayout>
</ScrollView>