<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#121212"
    android:clipToPadding="false"
    android:paddingTop="30dp"
    android:paddingBottom="40dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingLeft="20dp"
        android:paddingRight="20dp">

        <!-- CABECERA -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="PANEL DE CONTROL IT"
            android:textColor="#FFC107"
            android:textSize="24sp"
            android:textStyle="bold"
            android:gravity="center"
            android:layout_marginBottom="5dp"/>

        <TextView
            android:id="@+id/tvEstadoKiosco"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="🔒 Kiosco Activo"
            android:textColor="#4CAF50"
            android:textSize="14sp"
            android:gravity="center"
            android:layout_marginBottom="20dp"/>

        <!-- TARJETA DE TELEMETRÍA (SALUD DEL SISTEMA) -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:background="#1E1E1E"
            android:padding="15dp"
            android:layout_marginBottom="20dp"
            android:elevation="4dp">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="⚙️ Salud del Sistema"
                android:textColor="#FFFFFF"
                android:textSize="18sp"
                android:textStyle="bold"
                android:layout_marginBottom="10dp"/>

            <TextView
                android:id="@+id/tvTelemetriaUptime"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="⏱️ Tiempo activo: Calculando..."
                android:textColor="#B0BEC5"
                android:layout_marginBottom="5dp"/>

            <TextView
                android:id="@+id/tvTelemetriaAlmacenamiento"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="💾 Almacenamiento Libre: Calculando..."
                android:textColor="#B0BEC5"
                android:layout_marginBottom="5dp"/>

            <TextView
                android:id="@+id/tvVersionApp"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="📱 Versión: Calculando..."
                android:textColor="#B0BEC5"/>
        </LinearLayout>

        <!-- TARJETA DE CONFIGURACIÓN CON DESPLEGABLE SIN TECLADO -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:background="#1E1E1E"
            android:padding="15dp"
            android:layout_marginBottom="20dp">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="📍 Identificador de Terminal (Sección)"
                android:textColor="#FFFFFF"
                android:textSize="16sp"
                android:textStyle="bold"
                android:layout_marginBottom="10dp"/>

            <!-- AutoCompleteTextView configurado como selector puro (sin teclado) -->
            <AutoCompleteTextView
                android:id="@+id/etUbicacion"
                android:layout_width="match_parent"
                android:layout_height="50dp"
                android:background="#2C2C2C"
                android:textColor="#FFFFFF"
                android:padding="10dp"
                android:hint="Pulsa para seleccionar sección..."
                android:textColorHint="#757575"
                android:focusable="false"
                android:focusableInTouchMode="false"
                android:clickable="true"
                android:cursorVisible="false"
                android:layout_marginBottom="10dp"/>

            <Button
                android:id="@+id/btnGuardarConfig"
                android:layout_width="match_parent"
                android:layout_height="55dp"
                android:text="💾 GUARDAR IDENTIFICADOR"
                android:backgroundTint="#0288D1"
                android:textColor="#FFFFFF"
                android:textStyle="bold"/>
        </LinearLayout>

        <!-- TARJETA DE ACCIONES RÁPIDAS -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:background="#1E1E1E"
            android:padding="15dp"
            android:layout_marginBottom="20dp">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="⚡ Acciones de Mantenimiento"
                android:textColor="#FFFFFF"
                android:textSize="16sp"
                android:textStyle="bold"
                android:layout_marginBottom="10dp"/>

            <Button
                android:id="@+id/btnTestSincro"
                android:layout_width="match_parent"
                android:layout_height="55dp"
                android:text="🔄 FORZAR SINCRO CSV (EXCEL)"
                android:backgroundTint="#43A047"
                android:textColor="#FFFFFF"
                android:textStyle="bold"
                android:layout_marginBottom="10dp"/>

            <Button
                android:id="@+id/btnForzarOTA"
                android:layout_width="match_parent"
                android:layout_height="55dp"
                android:text="🚀 BUSCAR ACTUALIZACIÓN OTA"
                android:backgroundTint="#F57C00"
                android:textColor="#FFFFFF"
                android:textStyle="bold"
                android:layout_marginBottom="10dp"/>

            <Button
                android:id="@+id/btnVerLogsIt"
                android:layout_width="match_parent"
                android:layout_height="55dp"
                android:text="📋 VER REGISTROS (LOGS PERSISTENTES)"
                android:backgroundTint="#5E35B1"
                android:textColor="#FFFFFF"
                android:textStyle="bold"/>
        </LinearLayout>

        <!-- CONTROLES AVANZADOS -->
        <Button
            android:id="@+id/btnAbrirAjustesAndroid"
            android:layout_width="match_parent"
            android:layout_height="55dp"
            android:text="⚙️ ABRIR AJUSTES DE ANDROID"
            android:backgroundTint="#424242"
            android:textColor="#FFFFFF"
            android:layout_marginBottom="10dp"/>

        <Button
            android:id="@+id/btnCerrarPanelIT"
            android:layout_width="match_parent"
            android:layout_height="55dp"
            android:text="❌ CERRAR PANEL IT"
            android:backgroundTint="#C8102E"
            android:textColor="#FFFFFF"
            android:textStyle="bold"
            android:layout_marginBottom="30dp"/>

        <!-- FOOTER FIRMA CREADOR -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Terminal Operations\nDiseñado y desarrollado por Marco Carpi\nMADECEM"
            android:textColor="#757575"
            android:textSize="12sp"
            android:gravity="center"
            android:textStyle="italic"
            android:layout_marginBottom="20dp"/>

    </LinearLayout>
</ScrollView>