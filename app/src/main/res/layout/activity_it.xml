<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#F0F2F5"
    android:fillViewport="true"
    android:clipToPadding="false"
    android:paddingLeft="20dp"
    android:paddingTop="48dp"
    android:paddingRight="20dp"
    android:paddingBottom="80dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:text="🛠️ PANEL DE CONTROL IT - TGT"
            android:textColor="#C8102E"
            android:textSize="22sp"
            android:textStyle="bold"
            android:layout_marginTop="12dp"
            android:layout_marginBottom="6dp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:text="Configuración, Logs y Diagnóstico de Terminales"
            android:textColor="#5F6368"
            android:textSize="13sp"
            android:layout_marginBottom="24dp" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="#FFFFFF"
            android:orientation="vertical"
            android:padding="16dp"
            android:layout_marginBottom="16dp"
            android:elevation="2dp">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="📍 Ubicación de la Línea / Sección"
                android:textColor="#202124"
                android:textSize="15sp"
                android:textStyle="bold"
                android:layout_marginBottom="8dp" />

            <EditText
                android:id="@+id/etUbicacion"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:hint="Ej: Finales 3"
                android:inputType="text"
                android:paddingHorizontal="12dp"
                android:layout_marginBottom="12dp" />

            <Button
                android:id="@+id/btnGuardarConfig"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:backgroundTint="#C8102E"
                android:text="Guardar y Aplicar Ubicación"
                android:textColor="#FFFFFF"
                android:textStyle="bold" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="#FFFFFF"
            android:orientation="vertical"
            android:padding="16dp"
            android:layout_marginBottom="16dp"
            android:elevation="2dp">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="☁️ Sincronización y Diagnóstico Red"
                android:textColor="#202124"
                android:textSize="15sp"
                android:textStyle="bold"
                android:layout_marginBottom="12dp" />

            <Button
                android:id="@+id/btnTestSincro"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:backgroundTint="#0288D1"
                android:text="🔄 Forzar Sincronización con Excel"
                android:textColor="#FFFFFF"
                android:textStyle="bold"
                android:layout_marginBottom="8dp" />

            <Button
                android:id="@+id/btnVerLogsIt"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:backgroundTint="#2E7D32"
                android:text="📋 Ver Registros y Errores (Logs)"
                android:textColor="#FFFFFF"
                android:textStyle="bold"
                android:layout_marginBottom="8dp" />

            <Button
                android:id="@+id/btnForzarOTA"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:backgroundTint="#E65100"
                android:text="🚀 Comprobar Actualización OTA (GitHub)"
                android:textColor="#FFFFFF"
                android:textStyle="bold" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="#FFFFFF"
            android:orientation="vertical"
            android:padding="16dp"
            android:layout_marginBottom="24dp"
            android:elevation="2dp">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="🛡️ Sistema y Configuración Avanzada"
                android:textColor="#202124"
                android:textSize="15sp"
                android:textStyle="bold"
                android:layout_marginBottom="8dp" />

            <!-- AÑADIDO: Versión del programa -->
            <TextView
                android:id="@+id/tvVersionApp"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Versión instalada: Calculando..."
                android:textColor="#C8102E"
                android:textSize="14sp"
                android:textStyle="bold"
                android:layout_marginBottom="6dp" />

            <TextView
                android:id="@+id/tvEstadoKiosco"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Modo Kiosco / Control de Dispositivo Activo"
                android:textColor="#5F6368"
                android:textSize="13sp"
                android:layout_marginBottom="12dp" />

            <Button
                android:id="@+id/btnAbrirAjustesAndroid"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:backgroundTint="#424242"
                android:text="Abrir Ajustes Generales de Android"
                android:textColor="#FFFFFF"
                android:textStyle="bold" />
        </LinearLayout>

        <Button
            android:id="@+id/btnCerrarPanelIT"
            android:layout_width="match_parent"
            android:layout_height="60dp"
            android:backgroundTint="#202124"
            android:text="Cerrar Panel y Volver al Launcher"
            android:textColor="#FFFFFF"
            android:textStyle="bold"
            android:layout_marginBottom="20dp" />

    </LinearLayout>
</ScrollView>