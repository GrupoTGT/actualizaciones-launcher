<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/screensaverRoot"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#000000"
    tools:ignore="Overdraw">

    <LinearLayout
        android:id="@+id/screensaverContent"
        android:layout_width="280dp"
        android:layout_height="wrap_content"
        android:layout_gravity="center"
        android:background="@drawable/bg_main_card"
        android:gravity="center"
        android:orientation="vertical"
        android:paddingStart="18dp"
        android:paddingTop="16dp"
        android:paddingEnd="18dp"
        android:paddingBottom="18dp">

        <ImageView
            android:id="@+id/screensaverLogo"
            android:layout_width="match_parent"
            android:layout_height="68dp"
            android:contentDescription="@string/screensaver_logo_content_description"
            android:scaleType="centerInside"
            android:src="@drawable/logo_corporativo" />

        <com.grupotgt.launcherkioscotgt.RetroNetworkAntennaView
            android:id="@+id/screensaverAntenna"
            android:layout_width="72dp"
            android:layout_height="52dp"
            android:layout_marginTop="4dp"
            android:contentDescription="@string/retro_antenna_content_description"
            android:importantForAccessibility="yes" />

        <TextView
            android:id="@+id/screensaverTerminal"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:fontFamily="monospace"
            android:gravity="center"
            android:text="@string/screensaver_terminal_placeholder"
            android:textColor="#FFE58A"
            android:textSize="20sp"
            android:textStyle="bold" />

        <TextClock
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:fontFamily="monospace"
            android:format12Hour="HH:mm"
            android:format24Hour="HH:mm"
            android:gravity="center"
            android:textColor="#9CFF9F"
            android:textSize="66sp"
            android:textStyle="bold" />

        <TextClock
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:fontFamily="monospace"
            android:format12Hour="EEEE, d MMMM"
            android:format24Hour="EEEE, d MMMM"
            android:gravity="center"
            android:textColor="#B9F7C1"
            android:textSize="15sp" />

        <TextView
            android:id="@+id/screensaverConnection"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:fontFamily="monospace"
            android:gravity="center"
            android:text="@string/screensaver_connection_pending"
            android:textColor="#9CFF9F"
            android:textSize="12sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:fontFamily="monospace"
            android:gravity="center"
            android:text="@string/screensaver_tap_to_continue"
            android:textColor="#6EB97A"
            android:textSize="13sp"
            android:textStyle="bold" />
    </LinearLayout>
</FrameLayout>
